# ============================================================
#  Nihongo Kizuna — Backend Environment Variables
#  Sao chép file này thành .env rồi điền giá trị thật.
#  KHÔNG commit file .env lên git.
# ============================================================

# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas) ---
# Tạo cluster miễn phí tại https://cloud.mongodb.com
#
# ⚠️ BẮT BUỘC có authSource=admin.
# Khi chuỗi kết nối có tên database ở phần đường dẫn (/nihongo_kizuna), driver
# MongoDB sẽ mặc định đi xác thực Ở CHÍNH database đó thay vì ở 'admin'. Tài
# khoản do Atlas tạo lại nằm trong 'admin', nên thiếu tham số này sẽ báo lỗi
# "bad auth : authentication failed" dù mật khẩu hoàn toàn đúng.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nihongo_kizuna?retryWrites=true&w=majority&authSource=admin

# --- JWT ---
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu_khac_refresh
JWT_REFRESH_SECRET=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu_khac_access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- CORS / Frontend ---
# Nhiều origin cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Bảo mật ---
BCRYPT_ROUNDS=12

# --- Email OTP ---
# console  = in mã OTP ra log (dùng khi phát triển, không cần tài khoản email)
# sendgrid = gửi thật qua https://sendgrid.com (free tier 100 email/ngày)
# resend   = gửi thật qua https://resend.com (free tier 3000 email/tháng)
MAIL_PROVIDER=console
SENDGRID_API_KEY=
RESEND_API_KEY=
#
# ⚠️ Với SendGrid, MAIL_FROM phải là địa chỉ ĐÃ XÁC MINH ở
# Settings → Sender Authentication. Dùng địa chỉ chưa xác minh sẽ bị lỗi 403.
MAIL_FROM=Nihongo Kizuna <onboarding@resend.dev>

# Thử cấu hình email: npm run check:mail -- dia-chi@cua-ban.com

# --- Seed tài khoản quản trị đầu tiên ---
# Chạy: npm run seed:admin
ADMIN_SEED_EMAIL=admin@nihongo-kizuna.org
ADMIN_SEED_PASSWORD=DoiMatKhauNgay2026
ADMIN_SEED_NAME=Quản trị viên
